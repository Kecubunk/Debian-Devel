#!/usr/bin/env bash

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

WORKDIR="$HOME/Debian"
CD_DIR="$WORKDIR/cd-isi"
ISO_NAME="CarbonOS-netinst.iso"
PRESEED_SRC="$CD_DIR/preseed.cfg"

echo -e "${BLUE}[1/6] Memeriksa struktur direktori dan file preseed...${NC}"
if [ ! -d "$CD_DIR" ]; then
    echo -e "${RED}Error: Folder $CD_DIR tidak ditemukan!${NC}"
    exit 1
fi

echo -e "${BLUE}[2/6] Memaksa Bootloader (GRUB & ISOLINUX) ke Auto Install...${NC}"

# A. Override GRUB Config (UEFI)
cat << 'EOF' > "$CD_DIR/boot/grub/grub.cfg"
set default=0
set timeout=3

menuentry "CarbonOS Automated Installation" {
    linux   /install/vmlinuz auto=true priority=critical quiet ---
    initrd  /install/initrd.gz
}
EOF

# B. Override ISOLINUX Config (Legacy BIOS)
if [ -d "$CD_DIR/isolinux" ]; then
cat << 'EOF' > "$CD_DIR/isolinux/isolinux.cfg"
default install
prompt 0
timeout 30

label install
	kernel /install/vmlinuz
	append auto=true priority=critical initrd=/install/initrd.gz quiet ---
EOF
fi

echo -e "${BLUE}[3/6] Menyuntikkan preseed.cfg ke dalam initrd.gz...${NC}"
INITRD_PATH="$CD_DIR/install/initrd.gz"

if [ -f "$INITRD_PATH" ]; then
    TMP_CPIO=$(mktemp -d)
    cp "$PRESEED_SRC" "$TMP_CPIO/preseed.cfg"
    (cd "$TMP_CPIO" && echo preseed.cfg | cpio -H newc -o > preseed.cpio)
    cat "$TMP_CPIO/preseed.cpio" "$INITRD_PATH" > "$TMP_CPIO/initrd.new"
    mv "$TMP_CPIO/initrd.new" "$INITRD_PATH"
    rm -rf "$TMP_CPIO"
    echo -e "${GREEN}preseed.cfg berhasil disuntikkan.${NC}"
fi

echo -e "${BLUE}[4/6] Memperbarui file md5sum.txt...${NC}"
cd "$CD_DIR"
chmod -R u+w .
md5sum $(find . -type f ! -name "md5sum.txt" ! -path "./isolinux/*") > md5sum.txt
cd "$WORKDIR"

echo -e ""
read -p "Apakah Anda siap untuk mem-package ulang ISO ($ISO_NAME)? [y/N]: " CONFIRM

case "$CONFIRM" in
    [yY][eE][sS]|[yY])
        echo -e "${BLUE}[5/6] Menghapus ISO lama...${NC}"
        rm -f "$ISO_NAME"

        echo -e "${BLUE}[6/6] Membangun ISO baru menggunakan xorriso...${NC}"
        xorriso -as mkisofs \
          -r -V "CarbonOS" \
          -J -joliet-long \
          -b isolinux/isolinux.bin \
          -c isolinux/boot.cat \
          -boot-load-size 4 \
          -boot-info-table \
          -no-emul-boot \
          -eltorito-alt-boot \
          -e boot/grub/efi.img \
          -no-emul-boot \
          -isohybrid-gpt-basdat \
          -o "$ISO_NAME" \
          cd-isi/

        echo -e "${GREEN}Selesai! File ISO berhasil dibuat: $WORKDIR/$ISO_NAME${NC}"
        ;;
    *)
        echo -e "${RED}Proses pembentukan ISO dibatalkan.${NC}"
        exit 0
        ;;
esac
